modules = ["python-3.12", "web", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Preview GitHub Pages site"

[[workflows.workflow]]
name = "Preview GitHub Pages site"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd site && npm run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
